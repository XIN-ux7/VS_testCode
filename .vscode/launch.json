{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MyLaunch", 
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\_exe\\${fileBasenameNoExtension}.exe",
            "miDebuggerPath": "D:\\OS\\Development\\Environment\\mingw64\\bin\\gdb.exe",
            "preLaunchTask": "C/C++: gcc.exe 生成活动文件",
            "args": ["arg1", "arg2"], // 调试时传递的参数
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "MY_ENV_VAR",
                    "value": "value"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "logging": {
                "trace": true // 启用调试日志
            }
        }
    ]
}
